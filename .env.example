# Copy this file to .env and fill in your real values.
# .env is git-ignored and must never be committed.
#
# All three values come from Supabase: Settings -> API

# Your project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# The "anon / public" key. Safe to expose in browser code -
# it is restricted by your row-level security policies.
VITE_SUPABASE_ANON_KEY=

# The "service_role" key. FULL ADMIN ACCESS - bypasses all security rules.
# Never prefix this with VITE_. Anything starting with VITE_ is compiled into
# the public JavaScript bundle, where any visitor can read it.
# Server-side only (Vercel functions in /api).
SUPABASE_SERVICE_ROLE_KEY=

# Your live website address, with no trailing slash.
# e.g. https://ar7traders.com
# Used to build the link inside password-reset emails sent from the CRM.
# If it is missing, resets fall back to the Supabase default redirect.
SITE_URL=

# Optional: set to true to run the CRM against fake in-browser data
# (nothing touches your real database). Useful for training staff.
# VITE_CRM_DEMO=true

# Goo-net importer secret key. The scheduled GitHub Actions workflow calls
# /api/goonet-sync?key=<this> to run the importer on the free Vercel plan.
# Keep it long and random, add the same value as a GitHub Actions secret.
GOONET_SYNC_KEY=

# Goo-net importer relay (optional, recommended for Vercel). goo-net gates
# datacenter IPs, so the importer reads pages through a reader relay. The
# keyless free tier is rate-limited; a free API key from https://jina.ai
# lifts that. Set it in Vercel -> Settings -> Environment Variables.
# JINA_API_KEY=jina_xxxxxxxxxxxxxxxxxxxx
# GOONET_RELAY_URL=            # optional: use your own relay prefix instead
# AI fallback for the Goo-net importer (optional, recommended). When a run
# is a parse miss (goo-net changed its card markup), the importer asks the
# LLM to extract the cards and imports them through the same quality gate.
# Without a key the fallback is never called. Any Google AI project works.
# GEMINI_API_KEY=
# OPENAI_API_KEY=            # alternative provider, used only without Gemini

# On-site AI assistant (src/ChatWidget.jsx posts to the same /api/leads
# function). With GEMINI_API_KEY set, answers are grounded in the live
# site_listings + the contact settings; without it, a canned playbook
# answers. No extra Vercel function is added.

# Instant lead e-mail via Resend (optional). New website leads also e-mail
# you the moment they arrive. Fire-and-forget: the form's 201 never waits
# for the mail. Create a free key at https://resend.com/api-keys.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# LEAD_NOTIFY_TO=you@yourdomain.com
# LEAD_FROM=AR7 Traders <you@yourdomain.com>   # optional; needs a Resend-
#                                             # verified domain. Falls back to
#                                             # the Resend onboarding sender.
